# Copy to .env and fill in. Never commit .env.
#
# Web3Forms access key for the enquiry form. Free tier, 250 submissions/month.
# Obtain at https://web3forms.com by entering the destination inbox address.
PUBLIC_WEB3FORMS_KEY=

# Genesys Marketing newsletter subscribe form.
# Karim holds both values. The embed snippet itself is still unconfirmed:
# see docs/INTEGRATIONS.md before wiring these up.
PUBLIC_GENESYS_CLIENT_ID=
PUBLIC_GENESYS_FORM_ID=

# Calendly discovery-call event, free plan. Full scheduling URL.
# Example: https://calendly.com/travellingplaces/discovery-call
PUBLIC_CALENDLY_URL=
