---
import '../styles/tokens.css';
import '../styles/site.css';
import '../styles/pages.css';
import '../styles/blocks.css';
import '../styles/placeholders.css';

import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import NewsletterDialog from '../components/NewsletterDialog.astro';
import site from '../data/site.json';

interface Props {
  title: string;
  description?: string;
  page?: string;
  ogImage?: string;
}

const { title, description = site.description, page = 'home', ogImage = '/og-default.jpg' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

// Structured data. Address is confirmed; identifiers are still placeholders so they are
// deliberately omitted rather than published as TODO strings.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: site.name,
  description: site.description,
  url: Astro.site?.href,
  telephone: '+61755451600',
  email: site.email,
  foundingDate: String(site.founded),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    postalCode: site.address.postcode,
    addressCountry: site.address.country,
  },
  memberOf: [
    { '@type': 'Organization', name: 'Virtuoso' },
    { '@type': 'Organization', name: 'Australian Travel Industry Association' },
    { '@type': 'Organization', name: 'Cruise Lines International Association' },
  ],
  // Only confirmed profiles are published (owner, 25 October 2026).
  sameAs: Object.values(site.socials)
    .filter((s) => s.status === 'confirmed')
    .map((s) => s.url),
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#3d57a6" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/brand-kit/assets/logos/mark-light.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Self-hosted brand fonts, from the kit as published at /brand-kit/ (BRAND.md approves
        either delivery route). Since 25 October 2026, in place of Google Fonts: preloading the two
        files means the serif is usually ready at first paint, which removed a layout shift on the
        plain-opening pages (the heading reflowed by a line when Libre Baskerville swapped in), and
        visitors' requests no longer go to Google. */}
    <link rel="preload" href="/brand-kit/fonts/LibreBaskerville-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/brand-kit/fonts/IBMPlexSans-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/brand-kit/styles/fonts.css" />

    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
  </head>
  <body data-page={page}>
    <SiteHeader page={page} />
    <slot />
    <SiteFooter />
    <NewsletterDialog />
    <script src="../scripts/site.js"></script>
  </body>
</html>
