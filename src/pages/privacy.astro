---
/**
 * The privacy policy. The text lives in src/content/legal/privacy.md so it can be edited in the
 * CMS. It was drafted on 25 October 2026 at the owner's request (docs/WORK-PLAN.md, Q11), for this
 * website only, and stays a draft until a person with authority approves it (CLAUDE.md): until
 * `approved` is true the page carries a visible notice saying so. Rewritten on 1 November 2026 at
 * the owner's request as a standard Australian privacy policy for the whole business: every fact
 * only the business can supply is a [square-bracketed] gap, which renders red. Earlier research
 * and sources are in docs/PRIVACY-NOTES.md.
 */
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';

const policy = await getEntry('legal', 'privacy');
if (!policy) throw new Error('src/content/legal/privacy.md is missing.');
const { Content } = await render(policy);
const dateFormat = new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title={`${policy.data.title} | ${site.name}`}
  description="How Travelling Places handles personal information collected through this website."
  page="privacy"
>
  <main id="main">
    {/* A plain document, not a designed page (owner, 1 November 2026): title, status line and the
        text in one column, with ordinary headings and bullets. */}
    <section class="section legal-page">
      <div class="shell">
        <article class="legal-copy">
          <h1>{policy.data.title}</h1>
          {policy.data.approved && policy.data.approvedOn
            ? <p class="legal-dateline">Last updated {dateFormat.format(policy.data.approvedOn)}</p>
            : <p class="legal-dateline">
                <span class="bracket-placeholder" data-placeholder>[Draft of {dateFormat.format(policy.data.drafted)}, not yet approved]</span>
              </p>}
          <Content />
        </article>
      </div>
    </section>
  </main>
</BaseLayout>
