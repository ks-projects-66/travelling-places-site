---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
import copy from '../data/not-found.json';
---

<BaseLayout title={`Page not found | ${site.name}`} description="That page could not be found." page="404">
  <main id="main">
    <section class="page-hero page-hero--plain">
      <div class="shell">
        <h1><span class="hero-line">{copy.lead}</span> <span class="hero-accent">{copy.accent}</span></h1>
        <p>{copy.body}</p>
        <div class="hero-actions">
          <a class="button button-blue" href="/expertise/">{copy.primary}</a>
          <a class="text-link" href="/journal/">{copy.secondary}</a>
          <a class="text-link" href="/">{copy.home}</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
