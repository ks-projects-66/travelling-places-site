---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
---

<BaseLayout title={`Page not found | ${site.name}`} description="That page could not be found." page="404">
  <main id="main">
    <section class="page-hero">
      <div class="shell narrow-hero">
        <p class="section-label section-label-red">404</p>
        <h1>That page has<br /><em>moved on.</em></h1>
        <p>The page you were after is not here. The journal and our expertise are a good place to restart.</p>
        <div class="hero-actions">
          <a class="button button-blue" href="/">Back to the home page</a>
          <a class="text-link" href="/contact/">Get in touch <span aria-hidden="true">↘</span></a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
