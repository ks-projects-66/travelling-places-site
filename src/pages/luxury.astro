---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CardImage from '../components/CardImage.astro';
import WhyBook from '../components/WhyBook.astro';
import site from '../data/site.json';
import copy from '../data/luxury.json';

import luxuryHero from '../assets/images/destinations/cruise-dining.jpg';
---

<BaseLayout
  title={`${copy.title} | ${site.name}`}
  description="Extraordinary tailor-made journeys to the world's finest destinations: your own travel specialist, Virtuoso benefits, ATIA accreditation and support while you travel."
  page="luxury"
>
  <main id="main">
    <PageHero
      lead={copy.heroLead}
      accent={copy.heroAccent}
      lede={copy.heroLede}
      image={luxuryHero}
      alt="A dining table set beside a wide ocean view aboard ship"
      position="center 60%"
    />

    <section class="section">
      <div class="shell editorial-grid">
        <h2>{copy.intro.heading}</h2>
        <div class="long-copy">
          {copy.intro.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <section class="section luxury-themes">
      <div class="shell theme-grid">
        {copy.themes.map((theme) => (
          <article class="theme">
            <CardImage
              image={theme.image}
              alt={theme.imageAlt}
              label={theme.photo}
              ratio="4/5"
              position={theme.imagePosition}
              widths={[400, 640, 960]}
              sizes="(min-width: 900px) 31vw, 100vw"
            />
            <h2>{theme.title}</h2>
            <p>{theme.body}</p>
            {theme.link && <a class="text-link" href={theme.link.href}>{theme.link.label}</a>}
          </article>
        ))}
      </div>
    </section>

    <WhyBook />
  </main>
</BaseLayout>
