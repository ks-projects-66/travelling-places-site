---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CardImage from '../components/CardImage.astro';
import OpeningStatement from '../components/OpeningStatement.astro';
import WhyBook from '../components/WhyBook.astro';
import { Image } from 'astro:assets';
import site from '../data/site.json';
import copy from '../data/luxury.json';
import virtuoso from '../data/virtuoso.json';

// The island photograph opened the Virtuoso page. That page folded into this one on 25 October
// 2026, and the ocean-dining photograph this hero used now rotates in the home hero, so the
// island moves here and neither photograph appears twice.
import luxuryHero from '../assets/images/hero/virtuoso-island.jpg';
import virtuosoMark from '../assets/images/memberships/virtuoso-member-color.svg';
import VirtuosoBenefits from '../components/VirtuosoBenefits.astro';
---

<BaseLayout
  title={`${copy.title} | ${site.name}`}
  description="Extraordinary tailor-made journeys to the world's finest destinations: your own travel specialist, Virtuoso benefits, ATIA accreditation and support while you travel."
  page="luxury"
>
  <main id="main">
    <PageHero
      lead={copy.heroLead}
      accent={copy.heroAccent}
      lede={copy.heroLede}
      image={luxuryHero}
      alt="An aerial view of a small green island ringed by turquoise reef"
      position="center 42%"
    />

    <OpeningStatement heading={copy.intro.heading} paragraphs={copy.intro.paragraphs} id="luxury-intro-heading" />

    <section class="section luxury-themes">
      <div class="shell theme-grid">
        {copy.themes.map((theme) => (
          <article class="theme">
            <CardImage
              image={theme.image}
              alt={theme.imageAlt}
              label={theme.photo}
              ratio="4/5"
              position={theme.imagePosition}
              widths={[400, 640, 960]}
              sizes="(min-width: 900px) 31vw, 100vw"
            />
            <h2>{theme.title}</h2>
            <p>{theme.body}</p>
            {theme.link && <a class="text-link" href={theme.link.href}>{theme.link.label}</a>}
          </article>
        ))}
      </div>
    </section>

    {/* Gina's Virtuoso section, formerly its own page (docs/WORK-PLAN.md, change 2). Virtuoso is a
        membership network, not an accreditation, so it sits here as the mechanism behind the
        privileges described above rather than among the industry marks. */}
    <section class="section luxury-virtuoso" id="virtuoso" aria-labelledby="virtuoso-heading">
      {/* Split since 25 October 2026 (CO11): the mark, heading and Gina's introduction on the left,
          her two benefits as the section's main content on the right, where the page was empty.
          The mark is the transparent derivative at a size where "MEMBER" can be read; the opaque
          file showed as a small white box on the mist. */}
      <div class="shell split-section">
        <div class="split-lead">
          <Image class="virtuoso-mark" src={virtuosoMark} alt="Virtuoso member" height={130} loading="lazy" />
          <h2 id="virtuoso-heading">{virtuoso.intro.heading}</h2>
          {virtuoso.intro.paragraphs.map((p) => <p>{p}</p>)}
          <p class="luxury-virtuoso-links">
            <a class="text-link" href={site.virtuoso.profileUrl} target="_blank" rel="noreferrer"
              aria-label={`${virtuoso.profile.label} (opens in a new tab)`}>{virtuoso.profile.label}</a>
            {virtuoso.whiteLabel.url
              ? <a class="text-link" href={virtuoso.whiteLabel.url} target="_blank" rel="noreferrer"
                  aria-label={`${virtuoso.whiteLabel.label} (opens in a new tab)`}>{virtuoso.whiteLabel.label}</a>
              : <span class="placeholder-note" data-placeholder>TODO: Virtuoso white-label link not yet supplied</span>}
          </p>
        </div>
        <VirtuosoBenefits tone="light" />
      </div>
    </section>

    <WhyBook />
  </main>
</BaseLayout>
