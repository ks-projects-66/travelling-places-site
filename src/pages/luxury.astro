---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import WhyBook from '../components/WhyBook.astro';
import site from '../data/site.json';
import copy from '../data/luxury.json';
import virtuoso from '../data/virtuoso.json';

import luxuryHero from '../assets/images/destinations/cruise-dining.jpg';
import virtuosoMark from '../assets/images/memberships/virtuoso-member.png';
---

<BaseLayout
  title={`${copy.title} | ${site.name}`}
  description="Extraordinary tailor-made journeys to the world's finest destinations: your own travel specialist, Virtuoso benefits, ATIA accreditation and support while you travel."
  page="luxury"
>
  <main id="main">
    <PageHero
      lead={copy.heroLead}
      accent={copy.heroAccent}
      lede={copy.heroLede}
      image={luxuryHero}
      alt="A dining table set beside a wide ocean view aboard ship"
      position="center 60%"
    />

    <section class="section">
      <div class="shell editorial-grid">
        <h2>{copy.intro.heading}</h2>
        <div class="long-copy">
          {copy.intro.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <section class="section luxury-themes">
      <div class="shell theme-grid">
        {copy.themes.map((theme) => (
          <article class="theme">
            <PlaceholderImage label={theme.photo} ratio="4/5" />
            <h2>{theme.title}</h2>
            {theme.ways.map((way) => (
              <div class="theme-way">
                {way.virtuosoLink && (
                  <Image class="theme-mark" src={virtuosoMark} alt="Virtuoso member" width={160} densities={[1, 2]} loading="lazy" />
                )}
                <h3>{way.title}</h3>
                {way.paragraphs.map((p) => <p>{p}</p>)}
                {way.link && <a class="text-link" href={way.link.href}>{way.link.label}</a>}
                {way.virtuosoLink && (virtuoso.whiteLabel.url
                  ? <a class="text-link" href={virtuoso.whiteLabel.url} target="_blank" rel="noreferrer">{virtuoso.whiteLabel.label}</a>
                  : <p class="placeholder-note" data-placeholder>TODO: Virtuoso white-label link not yet supplied</p>)}
              </div>
            ))}
          </article>
        ))}
      </div>
    </section>

    <WhyBook />
  </main>
</BaseLayout>
