---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CardImage from '../components/CardImage.astro';
import OpeningStatement from '../components/OpeningStatement.astro';
import WhyBook from '../components/WhyBook.astro';
import VirtuosoBand from '../components/VirtuosoBand.astro';
import site from '../data/site.json';
import copy from '../data/luxury.json';

// The island photograph opened the Virtuoso page. That page folded into this one on 25 October
// 2026, and the ocean-dining photograph this hero used now rotates in the home hero, so the
// island moves here and neither photograph appears twice.
import luxuryHero from '../assets/images/hero/virtuoso-island.jpg';
---

<BaseLayout
  title={`${copy.title} | ${site.name}`}
  description="Luxury travel planned from Tamborine Mountain: your own advisor, Virtuoso benefits, ATIA accreditation and support while you travel."
  page="luxury"
>
  <main id="main">
    <PageHero
      lead={copy.heroLead}
      accent={copy.heroAccent}
      lede={copy.heroLede}
      image={luxuryHero}
      alt="An aerial view of a small green island ringed by turquoise reef"
      position="center 42%"
    />

    <OpeningStatement heading={copy.intro.heading} paragraphs={copy.intro.paragraphs} id="luxury-intro-heading" />

    <section class="section luxury-themes">
      <div class="shell theme-grid">
        {copy.themes.map((theme) => (
          <article class="theme">
            <CardImage
              image={theme.image}
              alt={theme.imageAlt}
              label={theme.photo}
              ratio="4/5"
              position={theme.imagePosition}
              widths={[400, 640, 960]}
              sizes="(min-width: 900px) 31vw, 100vw"
            />
            <h2>{theme.title}</h2>
            <p>{theme.body}</p>
            {theme.link && <a class="text-link" href={theme.link.href}>{theme.link.label}</a>}
          </article>
        ))}
      </div>
    </section>

    {/* The same Virtuoso band as Home, on the mist, linking out to the member profile
        (VirtuosoBand.astro). Virtuoso is a membership network, not an accreditation, so it sits
        here beside the luxury offer rather than among the industry marks. */}
    <VirtuosoBand tone="light" />

    <WhyBook />
  </main>
</BaseLayout>
