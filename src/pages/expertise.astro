---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CardImage from '../components/CardImage.astro';

import expertiseHero from '../assets/images/hero/expertise-mountain-lake.jpg';
import WhyBook from '../components/WhyBook.astro';
import site from '../data/site.json';
import copy from '../data/tailor-made.json';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  services.map(async (service) => ({ ...service, Body: (await render(service)).Content })),
);
---

<BaseLayout
  title={`${copy.heading} | ${site.name}`}
  description="Tell us what you're looking for and speak to a specialist who knows your destination. Tailor-made holidays, cruising, expeditions and luxury travel from Tamborine Mountain."
  page="expertise"
>
  <main id="main">
    <PageHero
      lead="Tailor-made and"
      accent="luxury holidays."
      image={expertiseHero}
      alt="Snow-capped mountains and forested slopes reflected in a still alpine lake at golden hour"
      position="center 38%"
    />

    <section class="section lead-statement">
      <div class="shell">
        <p>{copy.intro}</p>
      </div>
    </section>

    <section class="section service-cards">
      <div class="shell">
        {/* Gina's Tailor copy has no heading for the cards; render one only if the CMS sets it. */}
        {'servicesHeading' in copy && copy.servicesHeading && <h2>{copy.servicesHeading}</h2>}
        <div class="card-grid card-grid--two">
          {rendered.map(({ data, Body }) => (
            <article class="service-card" id={data.anchor}>
              <CardImage
                image={data.image}
                alt={data.imageAlt}
                label={`TODO: photo for ${data.label}`}
                ratio="3/2"
                position={data.imagePosition}
                widths={[480, 720, 1080]}
                sizes="(min-width: 900px) 45vw, 100vw"
              />
              <h3>{data.label}</h3>
              <p class="service-tagline">{data.title}</p>
              <div class="service-copy">
                <Body />
              </div>
              <ul class="tick-list">
                {data.points.map((point) => <li>{point}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    {copy.sections.map((section, i) => (
      <section class:list={['section', i % 2 === 0 && 'service-detail alt']}>
        <div class="shell editorial-grid">
          <h2>{section.heading}</h2>
          <div class="long-copy">
            {section.paragraphs.map((p) => <p>{p}</p>)}
          </div>
        </div>
      </section>
    ))}

    <WhyBook />
  </main>
</BaseLayout>
