---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CardImage from '../components/CardImage.astro';
import OpeningStatement from '../components/OpeningStatement.astro';

import expertiseHero from '../assets/images/hero/expertise-mountain-lake.jpg';
import WhyBook from '../components/WhyBook.astro';
import site from '../data/site.json';
import copy from '../data/tailor-made.json';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  services.map(async (service) => ({ ...service, Body: (await render(service)).Content })),
);
---

<BaseLayout
  title={`${copy.heading} | ${site.name}`}
  description="Tailor-made holidays, cruises, expeditions and luxury travel, planned with an advisor from the Main Street office on Tamborine Mountain."
  page="expertise"
>
  <main id="main">
    <PageHero
      lead={copy.heroLead}
      accent={copy.heroAccent}
      image={expertiseHero}
      alt="Snow-capped mountains and forested slopes reflected in a still alpine lake at golden hour"
      position="center 38%"
    />

    <OpeningStatement paragraphs={[copy.intro]} />

    <section class="section service-cards">
      <div class="shell">
        {/* Gina's Tailor copy has no visible heading for the cards. One is still needed so the card
            titles (h3) do not sit directly under the page h1 (POLISH-PLAN B7). It is visible if
            the CMS sets servicesHeading, and otherwise read by assistive technology only. */}
        {'servicesHeading' in copy && copy.servicesHeading
          ? <h2>{copy.servicesHeading}</h2>
          : <h2 class="visually-hidden">Our services</h2>}
        <div class="card-grid card-grid--two">
          {/* Photograph, title and paragraph, with the one link on Cruising. Removed on 1 November
              2026 (DESIGN.md): the two-by-two list of what each service covers, which wrapped
              unevenly and repeated the paragraph, and the one-line promise under the title, which
              competed with it as a second heading. `points` and `title` stay in the content files. */}
          {rendered.map(({ data, Body }) => (
            <article class="service-card" id={data.anchor}>
              <CardImage
                image={data.image}
                alt={data.imageAlt}
                label={`TODO: photo for ${data.label}`}
                ratio="3/2"
                position={data.imagePosition}
                widths={[480, 720, 1080]}
                sizes="(min-width: 900px) 45vw, 100vw"
              />
              <h3>{data.label}</h3>
              <div class="service-copy">
                <Body />
              </div>
              {data.link && (/^https?:\/\//.test(data.link.href)
                ? <a class="text-link service-link" href={data.link.href} target="_blank" rel="noreferrer">{data.link.label}<span class="visually-hidden"> (opens in a new tab)</span></a>
                : <a class="text-link service-link" href={data.link.href}>{data.link.label}</a>)}
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* One band, Gina's two sections side by side, each heading over its own paragraphs (owner,
        1 November 2026). As two stacked split sections, a heading alone in each lead column left a
        tall empty block under it, twice in a row. */}
    <section class="section service-detail alt">
      <div class="shell card-grid card-grid--two tailor-columns">
        {copy.sections.map((section) => (
          <article>
            <h2>{section.heading.split(/(\S+-\S+)/).map((part) => /\S-\S/.test(part) ? <span class="nowrap">{part}</span> : part)}</h2>
            <div>
              {section.paragraphs.map((p) => <p>{p}</p>)}
            </div>
          </article>
        ))}
      </div>
    </section>

    <WhyBook />
  </main>
</BaseLayout>
