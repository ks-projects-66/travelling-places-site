---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { Image } from 'astro:assets';

import expertiseHero from '../assets/images/hero/expertise-mountain-lake.jpg';
import ClosingCta from '../components/ClosingCta.astro';
import site from '../data/site.json';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  services.map(async (service) => ({ ...service, Body: (await render(service)).Content })),
);
---

<BaseLayout
  title={`Our expertise | ${site.name}`}
  description="Ocean and river cruising, expedition journeys, luxury travel and tailor-made itineraries, planned personally from Tamborine Mountain."
  page="expertise"
>
  <main id="main">
    <PageHero
      lead="Travel is personal."
      accent="Planning should be too."
      lede="We begin with how you want to feel, then bring together the right route, pace, people and places."
      image={expertiseHero}
      alt="Snow-capped mountains and forested slopes reflected in a still alpine lake at golden hour"
      position="center 38%"
    />

    {rendered.map(({ data, Body }, i) => (
      <section class:list={['service-detail', 'section', i % 2 === 1 && 'alt']} id={data.anchor}>
        <div class="shell service-grid">
          <div>
            <h2>{data.label}</h2>
            <p class="service-tagline">{data.title}</p>
          </div>
          <div class="service-copy">
            <Body />
            <ul class="tick-list">
              {data.points.map((point) => <li>{point}</li>)}
            </ul>
          </div>
        </div>
      </section>
    ))}

    <ClosingCta />
  </main>
</BaseLayout>
