---
/**
 * Contact opens on the enquiry, not a photograph. Someone who presses "Start planning" has already
 * decided; a 700px photograph of sky put the first field about 1,000px down on desktop and two
 * screens down a phone (design review, Contact finding 7). The title and its line now head the
 * page, and the form begins in the first screen at every width.
 *
 * The membership marks beside the form went the same day (finding 9, owner's instruction): the
 * footer row carries them on every page, so here they were the same four logos twice.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import CalendlyEmbed from '../components/CalendlyEmbed.astro';
import site from '../data/site.json';
import copy from '../data/contact.json';

const { street, locality, region, postcode, mapUrl } = site.address;
---

<BaseLayout
  title={`Contact | ${site.name}`}
  description="Visit us on Main Street, Tamborine Mountain, call 07 5545 1600, or send an enquiry and we will be in touch."
  page="contact"
>
  <main id="main">
    <section class="section contact-page" id="enquiry">
      <header class="shell contact-header">
        <h1><span class="hero-line">{copy.hero.lead}</span> <span class="hero-accent">{copy.hero.accent}</span></h1>
        <p class="contact-lede">{copy.hero.lede}</p>
      </header>
      <div class="shell contact-page-grid">
        <div class="contact-sidebar">
          <h2>{copy.details.heading}</h2>
          <address>
            <a href={mapUrl} target="_blank" rel="noreferrer">
              <strong>{site.name}</strong><br />{street}<br />{locality} {region} {postcode}
            </a>
            <a href={site.phoneLink}>{site.phone}</a>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </address>
          {site.openingHours.status === 'placeholder' ? (
            <p class="placeholder-note" data-placeholder>TODO: trading hours not yet confirmed</p>
          ) : (
            <p>{site.openingHours.value}</p>
          )}
          <p class="contact-visit">{copy.details.visit}</p>
          <div class="contact-social">
            <p>{copy.details.follow}</p>
            <a href={site.socials.instagram.url} target="_blank" rel="noreferrer">Instagram</a>
            <a href={site.socials.facebook.url} target="_blank" rel="noreferrer">Facebook</a>
            {(site.socials.instagram.status !== 'confirmed' || site.socials.facebook.status !== 'confirmed') && (
              <span class="placeholder-note" data-placeholder>TODO: social links not yet confirmed</span>
            )}
          </div>
        </div>
        <div class="contact-form-wrap">
          <h2>{copy.form.heading}</h2>
          <p>{copy.form.note}</p>
          <EnquiryForm context="contact" />
        </div>
      </div>
    </section>

    <section class="section contact-calendly" id="calendly">
      <div class="shell">
        <CalendlyEmbed />
      </div>
    </section>

  </main>
</BaseLayout>
