---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

import contactHero from '../assets/images/hero/contact-lookout.jpg';
import EnquiryForm from '../components/EnquiryForm.astro';
import CalendlyEmbed from '../components/CalendlyEmbed.astro';
import site from '../data/site.json';

import teamOutside from '../assets/images/team/team-outside.jpg';

const { street, locality, region, postcode, mapUrl } = site.address;
---

<BaseLayout
  title={`Contact | ${site.name}`}
  description="Visit us on Main Street, Tamborine Mountain, call 07 5545 1600, or send an enquiry and we will be in touch."
  page="contact"
>
  <main id="main">
    <PageHero
      lead="Tell us where your"
      accent="imagination is going."
      lede="You don't need to have every detail. A place, a date, or a feeling is enough to begin."
      image={contactHero}
      alt="A wide view over forested hills and farmland to distant peaks"
      position="center 55%"
    />

    <section class="section contact-page" id="enquiry">
      <div class="shell contact-page-grid">
        <div class="contact-sidebar">
          <h2>We're here on the Mountain.</h2>
          <address>
            <a href={mapUrl} target="_blank" rel="noreferrer">
              <strong>{site.name}</strong><br />{street}<br />{locality} {region} {postcode}
            </a>
            <a href={site.phoneLink}>{site.phone}</a>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </address>
          {site.openingHours.status === 'placeholder' ? (
            <p class="placeholder-note" data-placeholder>TODO: trading hours not yet confirmed</p>
          ) : (
            <p>{site.openingHours.value}</p>
          )}
          <div class="contact-social">
            <p>Follow the journey</p>
            <a href={site.socials.instagram.url} target="_blank" rel="noreferrer">Instagram</a>
            <a href={site.socials.facebook.url} target="_blank" rel="noreferrer">Facebook</a>
          </div>
        </div>
        <div class="contact-form-wrap">
          <h2>Start with the essentials.</h2>
          <p>Required fields are marked with an asterisk.</p>
          <EnquiryForm context="contact" />
        </div>
      </div>
    </section>

    <section class="section contact-calendly">
      <div class="shell">
        <CalendlyEmbed />
      </div>
    </section>

    <section class="section contact-photo">
      <div class="shell contact-photo-grid">
        <Image src={teamOutside} alt="The Travelling Places team on Tamborine Mountain"
          widths={[480, 960, 1440]} sizes="(max-width: 900px) 92vw, 50vw" loading="lazy" />
        <div>
          <h2>Come and see us.</h2>
          <p>
            We welcome appointments at our {street} office. Call ahead and we'll make time to sit down
            with your ideas.
          </p>
          <a class="button button-blue" href={site.phoneLink}>Call {site.phone}</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
