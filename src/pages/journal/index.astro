---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import site from '../../data/site.json';

const posts = (await getCollection('journal', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const featured = posts.find((post) => post.data.featured);
const archive = posts.filter((post) => post !== featured);
const years = [...new Set(archive.map((post) => post.data.date.getFullYear()))].sort((a, b) => b - a);

const dateFormat = new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
const href = (post: (typeof posts)[number]) => post.data.externalUrl ?? `/journal/${post.id}/`;
---

<BaseLayout
  title={`The journal | ${site.name}`}
  description="Practical advice, new discoveries and first-hand travel stories from the Travelling Places team."
  page="journal"
>
  <main id="main">
    <section class="page-hero journal-hero">
      <div class="shell narrow-hero">
        <p class="section-label section-label-red">The {site.name} journal</p>
        <h1>Ideas worth<br /><em>travelling for.</em></h1>
        <p>
          Gina's fortnightly notes, plus first-hand discoveries and practical guidance from the team,
          for the journey ahead.
        </p>
      </div>
    </section>

    {featured && (
      <section class="section featured-article">
        <div class="shell featured-article-grid">
          <Image src={featured.data.cover} alt={featured.data.coverAlt}
            widths={[480, 960, 1440]} sizes="(max-width: 900px) 92vw, 50vw" loading="eager" />
          <div>
            <p class="story-meta">Featured · {featured.data.category} · {dateFormat.format(featured.data.date)}</p>
            <h2>{featured.data.title}</h2>
            <p>{featured.data.standfirst}</p>
            <a class="button button-blue" href={href(featured)}>Read the article</a>
          </div>
        </div>
      </section>
    )}

    <section class="section archive">
      <div class="shell">
        <div class="archive-heading">
          <div>
            <p class="section-label section-label-red">From the archive</p>
            <h2>Stories, advice<br />and discoveries.</h2>
          </div>
          <div class="archive-filters" role="group" aria-label="Filter articles by year">
            <button type="button" class="is-active" data-filter="all" aria-pressed="true">All</button>
            {years.map((year) => (
              <button type="button" data-filter={String(year)} aria-pressed="false">{year}</button>
            ))}
          </div>
        </div>

        <div class="article-list" data-article-list>
          {archive.map((post) => (
            <article data-year-item={String(post.data.date.getFullYear())}>
              <Image src={post.data.cover} alt={post.data.coverAlt}
                widths={[320, 640]} sizes="(max-width: 700px) 92vw, 30vw" loading="lazy" />
              <div>
                <p class="story-meta">{post.data.category} · {dateFormat.format(post.data.date)}</p>
                <h3>{post.data.title}</h3>
                <p>{post.data.standfirst}</p>
                {post.data.externalUrl ? (
                  <a class="text-link" href={post.data.externalUrl} target="_blank" rel="noreferrer">
                    Read more <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <a class="text-link" href={`/journal/${post.id}/`}>
                    Read more <span aria-hidden="true">↘</span>
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
        <p class="empty-state" data-empty-state hidden>No articles found for that year.</p>
      </div>
    </section>

    <ClosingCta label="Inspired to go?" />
  </main>
</BaseLayout>
