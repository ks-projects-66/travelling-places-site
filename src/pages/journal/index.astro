---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WhyBook from '../../components/WhyBook.astro';
import site from '../../data/site.json';
import topBar from '../../data/top-bar.json';

// Newest first. On a shared date the entry flagged featured leads, so the feature is stable.
const posts = (await getCollection('journal', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf() || Number(b.data.featured) - Number(a.data.featured),
);
const [feature, ...log] = posts;
const categories = [...new Set(log.map((post) => post.data.category))];

// The log shows this many rows, then "Load more articles" reveals the rest. With fewer articles
// than this the button is not rendered at all.
const PAGE_SIZE = 10;

const dateFormat = new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
const href = (post: (typeof posts)[number]) => post.data.externalUrl ?? `/journal/${post.id}/`;
const publishedOn = (post: (typeof posts)[number]) =>
  post.data.externalUrl ? new URL(post.data.externalUrl).hostname.replace(/^www\./, '') : null;
const external = (post: (typeof posts)[number]) =>
  post.data.externalUrl ? { target: '_blank', rel: 'noreferrer' } : {};
---

<BaseLayout
  title={`The journal | ${site.name}`}
  description="Practical advice, new discoveries and first-hand travel stories from the Travelling Places team."
  page="journal"
>
  <main id="main">
    <section class="journal-header">
      <div class="shell journal-header-grid">
        <div>
          <h1>Notes from the road</h1>
          <p class="journal-standfirst">
            Gina's fortnightly notes, plus first-hand discoveries and practical guidance from the team,
            for the journey ahead.
          </p>
        </div>
        <a class="button button-blue" href={`mailto:${site.email}?subject=Newsletter%20sign-up`} data-open-newsletter>
          {topBar.newsletter.button}
        </a>
      </div>
    </section>

    {feature && (
      <section class="journal-feature-wrap">
        <div class="shell">
          <a class="journal-feature" href={href(feature)} {...external(feature)}>
            <Image src={feature.data.cover} alt={feature.data.coverAlt}
              widths={[768, 1280, 1920]} sizes="(max-width: 1248px) 100vw, 1200px" loading="eager" />
            <div class="journal-feature-text">
              <h2>{feature.data.title}</h2>
              <p class="byline">By {feature.data.author}</p>
              <p class="dateline">{dateFormat.format(feature.data.date)}</p>
              {publishedOn(feature) && <p class="dateline">Published on {publishedOn(feature)}</p>}
            </div>
          </a>
        </div>
      </section>
    )}

    {log.length > 0 && (
      <section class="section journal-log">
        <div class="shell">
          <div class="journal-log-heading">
            <h2>All articles</h2>
            <div class="archive-filters" role="group" aria-label="Filter articles by category">
              <button type="button" class="is-active" data-filter="all" aria-pressed="true">All</button>
              {categories.map((category) => (
                <button type="button" data-filter={category} aria-pressed="false">{category}</button>
              ))}
            </div>
          </div>

          <ol class="journal-rows">
            {log.map((post, i) => (
              <li data-category-item={post.data.category} data-beyond-page={i >= PAGE_SIZE ? '' : undefined}
                hidden={i >= PAGE_SIZE ? true : undefined}>
                <a class="journal-row" href={href(post)} {...external(post)}>
                  <Image src={post.data.cover} alt={post.data.coverAlt}
                    widths={[220, 440]} sizes="(max-width: 700px) 92vw, 220px" loading="lazy" />
                  <div>
                    <p class="story-meta">{post.data.category}</p>
                    <h3>{post.data.title}</h3>
                    <p class="byline">By {post.data.author}</p>
                    <p class="dateline">{dateFormat.format(post.data.date)}</p>
                    {publishedOn(post) && <p class="dateline">Published on {publishedOn(post)}</p>}
                  </div>
                </a>
              </li>
            ))}
          </ol>
          <p class="empty-state" data-empty-state hidden>No articles in that category yet.</p>
          {log.length > PAGE_SIZE && (
            <button class="button button-outline journal-more" type="button" data-load-more>Load more articles</button>
          )}
        </div>
      </section>
    )}

    <WhyBook />
  </main>
</BaseLayout>
