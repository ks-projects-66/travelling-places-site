---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import WhyBook from '../components/WhyBook.astro';
import site from '../data/site.json';
import about from '../data/about.json';

import teamOffice from '../assets/images/team/team-office.jpg';
import virtuosoMark from '../assets/images/memberships/virtuoso-member.png';

const team = await Promise.all(
  (await getCollection('team'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (member) => ({ ...member, Body: (await render(member)).Content })),
);

const atia = site.identifiers.atiaAccreditation;

// Story, cruise and Virtuoso alternate image and text, switching sides each row (design review,
// change 11). Two photographs are still to come and render as marked placeholders.
const rows = [
  { section: about.story, photo: 'TODO: photo of Gina, or the original Main Street office' },
  { section: about.cruise, photo: 'TODO: photo of a team member aboard ship' },
  { section: about.virtuoso, mark: true },
];
---

<BaseLayout
  title={`About us | ${site.name}`}
  description="Travelling Places was established by Gina Storey on Tamborine Mountain in 1993. Tailor-made holidays, CLIA cruise expertise and Virtuoso membership, from a privately owned, family business."
  page="team"
>
  <main id="main">
    <PageHero
      lead="People who know travel,"
      accent="and you."
      lede="Five advisors, a shared curiosity about the world, and a remarkably long memory for the details our clients care about."
      image={teamOffice}
      alt="The Travelling Places team in their Tamborine Mountain office"
      position="center 20%"
      maxWidth={904}
    />

    <section class="section">
      <div class="shell editorial-grid">
        <h2>{about.intro.heading}</h2>
        <div class="long-copy">
          {about.intro.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <section class="section about-rows">
      <div class="shell">
        {rows.map(({ section, photo, mark }, i) => (
          <div class:list={['image-row', i % 2 === 1 && 'image-row--reverse']}>
            {mark
              ? <div class="image-row-panel"><Image src={virtuosoMark} alt="Virtuoso member" width={280} densities={[1, 2]} loading="lazy" /></div>
              : <PlaceholderImage label={photo!} ratio="16/9" />}
            <div class="long-copy">
              <h2>{section.heading}</h2>
              {section.paragraphs.map((p) => <p>{p}</p>)}
              {'link' in section && section.link && <a class="text-link" href={section.link.href}>{section.link.label}</a>}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="section team-roster">
      <div class="shell">
        <h2>Meet your advisors</h2>
        <div class="card-grid card-grid--three">
          {team.map(({ id, data, Body }) => (
            <article class="team-card" id={`team-${id}`}>
              {data.portrait
                ? <Image src={data.portrait} alt={data.portraitAlt ?? data.name}
                    widths={[360, 720]} sizes="(max-width: 700px) 92vw, 30vw" loading="lazy" />
                : <PlaceholderImage label={`TODO: portrait of ${data.name}`} ratio="4/5" />}
              <h3>{data.name}</h3>
              <p class="role">{data.role}</p>
              <Body />
              {!data.approved && (
                <p class="placeholder-note" data-placeholder>TODO: title and bio not yet approved</p>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section team-values">
      <div class="shell value-grid value-grid--pairs">
        {about.promises.map((promise) => (
          <article>
            <h3>{promise.title}</h3>
            {promise.atiaNumber ? (
              <>
                <ul class="tick-list">
                  {promise.paragraphs.map((p) => <li>{p}</li>)}
                </ul>
                {atia.status === 'placeholder'
                  ? <p class="placeholder-note" data-placeholder>TODO: ATIA number (Gina's copy reads "??????")</p>
                  : <p>Our ATIA number is {atia.value}.</p>}
              </>
            ) : (
              promise.paragraphs.map((p) => <p>{p}</p>)
            )}
          </article>
        ))}
      </div>
    </section>

    <WhyBook />
  </main>
</BaseLayout>
