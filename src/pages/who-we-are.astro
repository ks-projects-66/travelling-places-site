---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CardImage from '../components/CardImage.astro';
import OpeningStatement from '../components/OpeningStatement.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import WhyBook from '../components/WhyBook.astro';
import site from '../data/site.json';
import about from '../data/about.json';

// The outdoor team photograph opened the home page until 25 October 2026, when the home hero became
// a sequence of destinations (docs/WORK-PLAN.md, change 3). It opens this page now, and the office
// photograph that did moves into the story of the business below.
import teamOutside from '../assets/images/team/team-outside.jpg';

const team = await Promise.all(
  (await getCollection('team'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (member) => ({
      ...member,
      Body: (await render(member)).Content,
      // A bio held only in an HTML comment is a draft no source supports, so the card shows a gap.
      hasBio: (member.body ?? '').replace(/<!--[\s\S]*?-->/g, '').trim() !== '',
    })),
);


// The page is about the people: the introduction, Gina's story beside her portrait, then the team.
// The cruise and Virtuoso rows moved to the home page on 1 November 2026 (owner: they have nothing
// to do with the team), into the Cruising card and the Virtuoso band.
const story = about.story;
---

<BaseLayout
  title={`About us | ${site.name}`}
  description={about.metaDescription}
  page="team"
>
  <main id="main">
    <PageHero
      lead={about.hero.lead}
      accent={about.hero.accent}
      lede={about.hero.lede}
      image={teamOutside}
      alt={about.hero.imageAlt}
      position="center 14%"
      maxWidth={1037}
    />

    <OpeningStatement heading={about.intro.heading} paragraphs={about.intro.paragraphs} id="about-heading" />

    <section class="section about-rows">
      <div class="shell">
        {/* Gina's portrait is a tall photograph, so the row keeps a portrait frame rather than
            cropping it to a face-height band (CO2). */}
        <div class="image-row image-row--portrait">
          <CardImage
            image={story.image}
            alt={story.imageAlt}
            label="TODO: photo of Gina, or the original Main Street office"
            ratio="4/5"
            position={story.imagePosition}
            widths={[600, 900, 1200]}
            sizes="(min-width: 900px) 46vw, 100vw"
          />
          <div class="long-copy">
            <h2>{story.heading}</h2>
            {story.paragraphs.map((p) => <p>{p}</p>)}
            {/* Read as Gina's own words, so it stays empty until she supplies one (register C26).
                Beside her portrait since 1 November 2026; it was on the home page. */}
            {story.quote
              ? <blockquote>{story.quote}</blockquote>
              : <p class="placeholder-note" data-placeholder>TODO: a line from Gina, in her own words</p>}
          </div>
        </div>
      </div>
    </section>

    <section class="section team-roster">
      <div class="shell">
        <h2>Meet your advisors</h2>
        <div class="card-grid card-grid--four">
          {team.map(({ id, data, Body, hasBio }) => (
            <article class="team-card" id={`team-${id}`}>
              {data.portrait
                ? <Image src={data.portrait} alt={data.portraitAlt ?? data.name}
                    widths={[360, 720]} sizes="(max-width: 560px) 92vw, (max-width: 1100px) 46vw, 23vw" loading="lazy" />
                : <PlaceholderImage label={`TODO: portrait of ${data.name}`} ratio="4/5" />}
              <h3>{data.name}</h3>
              <p class="role">{data.role}</p>
              <Body />
              {!data.approved && (
                <p class="placeholder-note" data-placeholder>
                  {hasBio ? 'TODO: title and bio not yet approved' : 'TODO: title and bio not yet supplied'}
                </p>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <WhyBook />
  </main>
</BaseLayout>
