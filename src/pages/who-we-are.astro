---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import WhyBook from '../components/WhyBook.astro';
import site from '../data/site.json';
import about from '../data/about.json';

import teamOffice from '../assets/images/team/team-office.jpg';
import ginaPortrait from '../assets/images/team/gina-storey.webp';
import virtuosoMark from '../assets/images/memberships/virtuoso-member.png';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const founder = team.find((member) => member.data.founder);
const advisors = await Promise.all(
  team
    .filter((member) => !member.data.founder)
    .map(async (member) => ({ ...member, Body: (await render(member)).Content })),
);
const FounderBody = founder ? (await render(founder)).Content : null;

const atia = site.identifiers.atiaAccreditation;
---

<BaseLayout
  title={`About us | ${site.name}`}
  description="Travelling Places was established by Gina Storey on Tamborine Mountain in 1993. Tailor-made holidays, CLIA cruise expertise and Virtuoso membership, from a privately owned, family business."
  page="team"
>
  <main id="main">
    <PageHero
      lead="People who know travel,"
      accent="and you."
      lede="Five advisors, a shared curiosity about the world, and a remarkably long memory for the details our clients care about."
      image={teamOffice}
      alt="The Travelling Places team in their Tamborine Mountain office"
      position="center 20%"
      maxWidth={904}
    />

    <section class="section">
      <div class="shell editorial-grid">
        <div>
          <h2>{about.intro.heading}</h2>
        </div>
        <div class="long-copy">
          {about.intro.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <section class="section about-story">
      <div class="shell editorial-grid">
        <div>
          <h2>{about.story.heading}</h2>
        </div>
        <div class="long-copy">
          {about.story.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <section class="section service-detail alt">
      <div class="shell editorial-grid">
        <div>
          <h2>{about.cruise.heading}</h2>
        </div>
        <div class="long-copy">
          {about.cruise.paragraphs.map((p) => <p>{p}</p>)}
          <a class="text-link" href={about.cruise.link.href}>{about.cruise.link.label}</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="shell editorial-grid">
        <div>
          <Image class="about-virtuoso-mark" src={virtuosoMark} alt="Virtuoso member" width={240} densities={[1, 2]} loading="lazy" />
          <h2>{about.virtuoso.heading}</h2>
        </div>
        <div class="long-copy">
          {about.virtuoso.paragraphs.map((p) => <p>{p}</p>)}
          <a class="text-link" href={about.virtuoso.link.href}>{about.virtuoso.link.label}</a>
        </div>
      </div>
    </section>

    <section class="section team-roster">
      <div class="shell">
        {founder && FounderBody && (
          <div class="roster-feature">
            <div class="founder-visual">
              <Image src={ginaPortrait} alt={founder.data.portraitAlt ?? founder.data.name}
                widths={[400, 800]} sizes="(max-width: 900px) 80vw, 38vw" loading="lazy" />
            </div>
            <div>
              <h2>{founder.data.name}</h2>
              <p class="roster-role">{founder.data.role}</p>
              <FounderBody />
            </div>
          </div>
        )}

        <div class="roster-list">
          {advisors.map(({ data, Body }) => (
            <article>
              <div>
                <p class="role">{data.role}</p>
                <h3>{data.name}</h3>
              </div>
              <Body />
              {!data.approved && (
                <p class="placeholder-note" data-placeholder>TODO: title and bio not yet approved</p>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section team-values">
      <div class="shell value-grid value-grid--pairs">
        {about.promises.map((promise) => (
          <article>
            <h3>{promise.title}</h3>
            {promise.paragraphs.map((p, i) => (
              <>
                <p>{p}</p>
                {promise.atiaNumber && i === 0 && (atia.status === 'placeholder'
                  ? <p class="placeholder-note" data-placeholder>TODO: ATIA number (Gina's copy reads "??????")</p>
                  : <p>Our ATIA number is {atia.value}.</p>)}
              </>
            ))}
          </article>
        ))}
      </div>
    </section>

    <WhyBook />
  </main>
</BaseLayout>
