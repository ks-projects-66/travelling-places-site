---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CardImage from '../components/CardImage.astro';
import OpeningStatement from '../components/OpeningStatement.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import WhyBook from '../components/WhyBook.astro';
import site from '../data/site.json';
import about from '../data/about.json';

// The outdoor team photograph opened the home page until 25 October 2026, when the home hero became
// a sequence of destinations (docs/WORK-PLAN.md, change 3). It opens this page now, and the office
// photograph that did moves into the story of the business below.
import teamOutside from '../assets/images/team/team-outside.jpg';
import virtuosoMark from '../assets/images/memberships/virtuoso-member-color.svg';

const team = await Promise.all(
  (await getCollection('team'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (member) => ({ ...member, Body: (await render(member)).Content })),
);


// Story, cruise and Virtuoso alternate image and text, switching sides each row (design review,
// change 11). The story row carries the office photograph; the cruise row's photograph is still to
// come and renders as a marked placeholder.
const rows = [
  // Gina's portrait is a tall photograph, so its row keeps a portrait frame rather than being
  // cropped to a face-height band (CO2).
  { section: about.story, photo: 'TODO: photo of Gina, or the original Main Street office', ratio: '4/5' as const },
  { section: about.cruise, photo: 'TODO: photo of a team member aboard ship' },
  { section: about.virtuoso, mark: true },
];
---

<BaseLayout
  title={`About us | ${site.name}`}
  description="Travelling Places was established by Gina Storey on Tamborine Mountain in 1993. Tailor-made holidays, CLIA cruise expertise and Virtuoso membership, from a privately owned, family business."
  page="team"
>
  <main id="main">
    <PageHero
      lead="People who know travel,"
      accent="and you."
      lede="Advisors with a shared curiosity about the world, and a remarkably long memory for the details our clients care about."
      image={teamOutside}
      alt="The Travelling Places team together on Tamborine Mountain"
      position="center 14%"
      maxWidth={1037}
    />

    <OpeningStatement heading={about.intro.heading} paragraphs={about.intro.paragraphs} id="about-heading" />

    <section class="section about-rows">
      <div class="shell">
        {rows.map(({ section, photo, mark, ratio }, i) => (
          <div class:list={['image-row', i % 2 === 1 && 'image-row--reverse', ratio === '4/5' && 'image-row--portrait']}>
            {/* Every row now carries a photograph. The Virtuoso row's slot held only the logo in a
                large mist box (CO12); the mark now sits small above its heading, as on Luxury. */}
            <CardImage
                  image={'image' in section ? section.image : undefined}
                  alt={'imageAlt' in section ? section.imageAlt : undefined}
                  label={photo!}
                  ratio={ratio ?? '16/9'}
                  position={'imagePosition' in section ? section.imagePosition : undefined}
                  widths={[600, 900, 1200]}
                  sizes="(min-width: 900px) 46vw, 100vw"
                />
            <div class="long-copy">
              {mark && <Image class="virtuoso-mark row-mark" src={virtuosoMark} alt="Virtuoso member" height={90} loading="lazy" />}
              <h2>{section.heading}</h2>
              {section.paragraphs.map((p) => <p>{p}</p>)}
              {'link' in section && section.link && <a class="text-link" href={section.link.href}>{section.link.label}</a>}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="section team-roster">
      <div class="shell">
        <h2>Meet your advisors</h2>
        <div class="card-grid card-grid--four">
          {team.map(({ id, data, Body }) => (
            <article class="team-card" id={`team-${id}`}>
              {data.portrait
                ? <Image src={data.portrait} alt={data.portraitAlt ?? data.name}
                    widths={[360, 720]} sizes="(max-width: 560px) 92vw, (max-width: 1100px) 46vw, 23vw" loading="lazy" />
                : <PlaceholderImage label={`TODO: portrait of ${data.name}`} ratio="4/5" />}
              <h3>{data.name}</h3>
              <p class="role">{data.role}</p>
              <Body />
              {!data.approved && (
                <p class="placeholder-note" data-placeholder>TODO: title and bio not yet approved</p>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <WhyBook />
  </main>
</BaseLayout>
