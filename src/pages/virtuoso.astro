---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

import virtuosoHero from '../assets/images/hero/virtuoso-island.jpg';
import ClosingCta from '../components/ClosingCta.astro';
import site from '../data/site.json';

import virtuosoMark from '../assets/images/memberships/virtuoso-member.png';
import orientExpress from '../assets/images/journal/european-rail.jpg';

const values = [
  { title: 'Recognition', body: 'Your preferences can travel ahead of you, helping partner hotels create a more personal welcome.' },
  { title: 'Added value', body: 'Selected bookings may include benefits such as breakfast, credits, upgrades or flexible check-in.' },
  { title: 'Local access', body: 'Trusted destination specialists bring context, contacts and first-hand knowledge on the ground.' },
];
---

<BaseLayout
  title={`Virtuoso | ${site.name}`}
  description="What Virtuoso membership means for the way we plan your travel, and the partners it opens up."
  page="virtuoso"
>
  <main id="main">
    <PageHero
      lead="Connections that"
      accent="make travel richer."
      lede="Virtuoso brings together leading travel advisors and carefully selected partners across the world."
      image={virtuosoHero}
      alt="An aerial view of a small green island ringed by turquoise reef"
      position="center 42%"
    >
      <Image slot="above" class="hero-partner-logo" src={virtuosoMark} alt="Virtuoso member" width={376} densities={[1, 2]} loading="eager" />
    </PageHero>

    <section class="section">
      <div class="shell editorial-grid">
        <div>
          <h2>More than a booking.</h2>
        </div>
        <div class="long-copy">
          <p>
            As a Virtuoso member, {site.name} can connect clients with a global community of respected
            hotels, cruise lines, tour operators and destination experts.
          </p>
          <p>
            Depending on the partner and booking, that can mean thoughtful amenities, preferred
            treatment and the confidence that local relationships are working behind the scenes.
          </p>
        </div>
      </div>
    </section>

    <section class="section value-band">
      <div class="shell value-grid">
        {values.map((value) => (
          <article><h3>{value.title}</h3><p>{value.body}</p></article>
        ))}
      </div>
    </section>

    <section class="section image-editorial">
      <div class="shell image-editorial-grid">
        <Image src={orientExpress} alt="An elegant journey through Europe"
          widths={[480, 960]} sizes="(max-width: 900px) 92vw, 46vw" loading="lazy" />
        <div>
          <h2>The network is global. Your advisor is still right here.</h2>
          <p>
            We bring the relationships of an international network together with the continuity of a
            local team who knows your plans.
          </p>
          <a class="button button-blue" href="/contact/">Plan with us</a>
          <a class="text-link secondary-link" href={site.virtuoso.profileUrl} target="_blank" rel="noreferrer">
            View our Virtuoso profile
         </a>
        </div>
      </div>
    </section>

    <ClosingCta />
  </main>
</BaseLayout>
