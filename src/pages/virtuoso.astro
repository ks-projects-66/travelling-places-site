---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

import virtuosoHero from '../assets/images/hero/virtuoso-island.jpg';
import WhyBook from '../components/WhyBook.astro';
import site from '../data/site.json';
import copy from '../data/virtuoso.json';

import virtuosoMark from '../assets/images/memberships/virtuoso-member.png';
import orientExpress from '../assets/images/journal/european-rail.jpg';
---

<BaseLayout
  title={`Virtuoso | ${site.name}`}
  description="Travelling Places is part of the invitation only Virtuoso travel group. Complimentary breakfast, hotel credits, upgrades and on board credits for our clients."
  page="virtuoso"
>
  <main id="main">
    <PageHero
      lead="Connections that"
      accent="enrich travel."
      lede="Virtuoso brings together leading travel advisors and carefully selected partners across the world."
      image={virtuosoHero}
      alt="An aerial view of a small green island ringed by turquoise reef"
      position="center 42%"
    >
      <Image slot="above" class="hero-partner-logo" src={virtuosoMark} alt="Virtuoso member" width={376} densities={[1, 2]} loading="eager" />
    </PageHero>

    <section class="section">
      <div class="shell editorial-grid">
        <div>
          <h2>{copy.intro.heading}</h2>
        </div>
        <div class="long-copy">
          {copy.intro.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <section class="section value-band">
      <div class="shell">
        <div class="value-grid value-grid--pairs">
          {copy.benefits.map((benefit) => (
            <article><h3>{benefit.title}</h3><p>{benefit.body}</p></article>
          ))}
        </div>
        <div class="value-band-closing">
          <p>{copy.closing}</p>
          {copy.whiteLabel.url
            ? <a class="text-link text-link--onDark" href={copy.whiteLabel.url} target="_blank" rel="noreferrer">{copy.whiteLabel.label}</a>
            : <p class="placeholder-note" data-placeholder>TODO: Virtuoso white-label link not yet supplied</p>}
        </div>
      </div>
    </section>

    <section class="section image-editorial">
      <div class="shell image-editorial-grid">
        <Image src={orientExpress} alt="An elegant journey through Europe"
          widths={[480, 960]} sizes="(max-width: 900px) 92vw, 46vw" loading="lazy" />
        <div>
          <h2>The network is global. Your advisor is still right here.</h2>
          <p>
            We bring the relationships of an international network together with the continuity of a
            local team who knows your plans.
          </p>
          <a class="button button-blue" href="/contact/">Plan with us</a>
          <a class="text-link secondary-link" href={site.virtuoso.profileUrl} target="_blank" rel="noreferrer">
            View our Virtuoso profile
         </a>
        </div>
      </div>
    </section>

    <WhyBook />
  </main>
</BaseLayout>
