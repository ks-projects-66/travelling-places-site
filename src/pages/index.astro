---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import WhyBook from '../components/WhyBook.astro';
import site from '../data/site.json';

import womanOnPlane from '../assets/images/hero/woman-on-plane.jpg';
import ginaPortrait from '../assets/images/team/gina-storey.webp';
import virtuosoMark from '../assets/images/memberships/virtuoso-member.png';

import mediterranean from '../assets/images/destinations/mediterranean-coast.jpg';
import antarctica from '../assets/images/destinations/antarctica-ice.jpg';
import cruise from '../assets/images/destinations/cruise-dining.jpg';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const gina = await getEntry('team', 'gina-storey');
const featured = (await getCollection('journal', ({ data }) => data.featured && !data.draft))[0];

// The hero is a sequence of destination photographs under one fixed title (docs/WORK-PLAN.md,
// change 3). The team photograph that opened this page now opens About.
const heroSlides = [
  { src: mediterranean, alt: 'The sun setting over the Mediterranean beyond a dark headland', position: 'center 55%' },
  { src: antarctica, alt: 'A wide Antarctic landscape of ice, sea and distant mountains', position: 'center 45%' },
  { src: cruise, alt: 'A dining table set beside a wide ocean view aboard ship', position: 'center 55%' },
];

const dateFormat = new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={`${site.name} | ${site.tagline}`} page="home">
  <main id="main">
    <PageHero
      lead="Your world,"
      accent="beautifully planned."
      lede="Thoughtful journeys, rare experiences and every detail looked after by people who know travel, and take the time to know you."
      slides={heroSlides}
    >
      <div class="hero-actions">
        <a class="button button-blue" href="/contact/" data-carousel-hold>Start planning</a>
        <a class="text-link text-link--onDark" href="/expertise/" data-carousel-hold>Explore our expertise</a>
      </div>
    </PageHero>

    <section class="section intro">
      <div class="shell intro-grid">
        <div class="intro-mark" aria-hidden="true">
          <Image src={womanOnPlane} alt="" widths={[414, 828]} sizes="30vw" loading="lazy" />
        </div>
        <div class="intro-copy">
          <p>Travel has changed. Good service shouldn't.</p>
          <h2>Personal, professional advice is still the best way to see the world.</h2>
        </div>
        <div class="intro-detail">
          <p>
            From a quick escape to a three-month journey, {site.name} brings together more than 100
            years of collective industry experience to get the details right.
          </p>
          <a class="text-link" href="/who-we-are/">Meet Gina and the team</a>
        </div>
      </div>
    </section>

    <section class="section expertise-preview">
      <div class="shell">
        <div class="section-heading split-heading">
          <h2><span class="hero-line">Journeys shaped</span> around you.</h2>
          <p>
            Every traveller is different. We bring first-hand knowledge and careful judgement to the
            way you want to explore.
          </p>
        </div>
        <div class="expertise-list">
          {services.map((service) => (
            <a class="expertise-row" href={`/expertise/#${service.data.anchor}`}>
              <h3>{service.data.label}</h3>
              <p>{service.data.summary}</p>
              <svg class="row-arrow" aria-hidden="true" focusable="false">
                <use href="/brand-kit/assets/icons/ui-icons.svg#icon-chevron-right"></use>
              </svg>
           </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section home-virtuoso">
      <div class="shell virtuoso-grid">
        <div class="virtuoso-copy">
          <h2>More doors open with the right connections.</h2>
          <p>
            Our Virtuoso membership connects you with leading hotels, cruise lines, destination
            specialists and tour partners around the world.
          </p>
          <a class="button button-white" href="/luxury/#virtuoso">Why Virtuoso matters</a>
        </div>
        <div class="virtuoso-panel">
          <Image src={virtuosoMark} alt="Virtuoso member" width={376} densities={[1, 2]} loading="lazy" />
          <p>A global perspective, delivered with the attention of your local travel advisor.</p>
        </div>
      </div>
    </section>

    {gina && (
      <section class="section founder-feature">
        <div class="shell about-grid">
          <div class="founder-visual">
            <Image src={ginaPortrait} alt={gina.data.portraitAlt ?? gina.data.name}
              widths={[400, 800]} sizes="(max-width: 900px) 80vw, 38vw" loading="lazy" />
            <div class="founder-caption"><strong>{gina.data.name}</strong><span>{gina.data.role}</span></div>
          </div>
          <div class="about-copy">
            <h2>A travel company built on curiosity and care.</h2>
            <p class="about-lead">
              Gina brought her industry experience from New Zealand and London to {site.address.locality} and founded
              {' '}{site.name} in {site.founded}.
            </p>
            <p>
              More than three decades later, the company still works the way she intended: listen
              carefully, share honest advice and look after every detail.
            </p>
            <blockquote>
              Our focus is on you, ensuring we offer the very best arrangements to fulfil your travel
              dreams.
            </blockquote>
            <a class="text-link" href="/who-we-are/">Meet the whole team</a>
          </div>
        </div>
      </section>
    )}

    {featured && (
      <section class="section journal-teaser">
        <div class="shell">
          <div class="section-heading split-heading">
            <div>
              <h2><span class="hero-line">Notes from</span> the road.</h2>
            </div>
            <p>
              A fortnightly collection of practical advice, new discoveries and first-hand travel
              stories from Gina and the team.
            </p>
          </div>
          <div class="teaser-story">
            <Image src={featured.data.cover} alt={featured.data.coverAlt}
              widths={[480, 960]} sizes="(max-width: 900px) 92vw, 46vw" loading="lazy" />
            <div>
              <p class="story-meta">{featured.data.category} · {dateFormat.format(featured.data.date)}</p>
              <h3>{featured.data.title}</h3>
              <p>{featured.data.standfirst}</p>
              <a class="text-link" href={`/journal/${featured.id}/`}>Read the story</a>
            </div>
          </div>
          <a class="button button-outline" href="/journal/">View the journal</a>
        </div>
      </section>
    )}

    <WhyBook />
  </main>
</BaseLayout>
