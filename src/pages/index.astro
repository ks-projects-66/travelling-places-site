---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CardImage from '../components/CardImage.astro';
import WhyBook from '../components/WhyBook.astro';
import site from '../data/site.json';
import home from '../data/home.json';
import virtuoso from '../data/virtuoso.json';

import teamOffice from '../assets/images/team/team-office.jpg';
import virtuosoMark from '../assets/images/memberships/virtuoso-member-reverse-color.svg';
import VirtuosoBenefits from '../components/VirtuosoBenefits.astro';

import positano from '../assets/images/destinations/positano-golden-hour.jpg';
import varenna from '../assets/images/destinations/varenna-loggia-lake-como.jpg';
import lakeComo from '../assets/images/destinations/lake-como-sunset.jpg';

const services = await getCollection('services');
const gina = await getEntry('team', 'gina-storey');
const featured = (await getCollection('journal', ({ data }) => data.featured && !data.draft))[0];

// The hero is a sequence of photographs under one fixed title (docs/WORK-PLAN.md, change 3).
// Replaced 25 October 2026 (docs/CALLOUTS-2026-10-25.md, CO1): the sunset, the Spanish village and
// the ship's dining room read as generic stock, not luxury. The new three run coast, a place to stay,
// and water at dusk, all warm and in natural light, each with calm ground lower left for the title.
// None is used anywhere else on the site.
const heroSlides = [
  { src: positano, alt: 'Positano climbing the cliffs above a calm sea at golden hour', position: '28% 78%' },
  { src: varenna, alt: 'Stone arches of a lakeside villa loggia framing Lake Como and the mountains', position: 'center 58%' },
  { src: lakeComo, alt: 'A villa and cypresses beside Lake Como, the still water glowing at sunset', position: '35% 50%' },
];

// Two journeys on the home page, each with its photograph from the Tailor-made page (client brief,
// change 4). The label and destination come from home.json; the photograph and summary come from
// the service entry, so the two pages describe a service the same way.
const journeyCards = home.journeys.cards.map((card) => {
  const service = services.find((s) => s.id === card.service);
  if (!service) throw new Error(`home.json names a service that does not exist: ${card.service}`);
  return { ...card, service: service.data };
});

---

<BaseLayout title={`${site.name} | ${site.tagline}`} page="home">
  <main id="main">
    <PageHero lead={home.hero.lead} accent={home.hero.accent} lede={home.hero.lede} slides={heroSlides}>
      <div class="hero-actions">
        <a class="button button-blue" href="/contact/#enquiry" data-carousel-hold>{home.hero.primary}</a>
        <a class="text-link text-link--onDark" href="/expertise/" data-carousel-hold>{home.hero.secondary}</a>
      </div>
    </PageHero>

    <section class="section intro">
      <div class="shell editorial-grid">
        <h2>{home.intro.heading}</h2>
        <p class="intro-lead">{home.intro.lead}</p>
        <p class="intro-detail">{home.intro.detail}</p>
        <a class="text-link" href="/who-we-are/">{home.intro.link}</a>
      </div>
    </section>

    <section class="section journeys" aria-labelledby="journeys-heading">
      <div class="shell">
        <div class="section-intro">
          <h2 id="journeys-heading">{home.journeys.heading}</h2>
          <p>{home.journeys.intro}</p>
        </div>
        <div class="journey-cards">
          {journeyCards.map((card) => {
            const external = /^https?:\/\//.test(card.href);
            return (
            <a class="journey-card" href={card.href} target={external ? '_blank' : undefined} rel={external ? 'noreferrer' : undefined}>
              <CardImage
                image={card.service.image}
                alt={card.service.imageAlt}
                label={`TODO: photo for ${card.label}`}
                ratio="3/2"
                position={card.service.imagePosition}
                widths={[480, 720, 1080, 1440]}
                sizes="(min-width: 900px) 46vw, 100vw"
              />
              <h3>{card.label}</h3>
              <p>{card.service.summary}</p>
              <span class="journey-card-link">{card.link}{external && <span class="visually-hidden"> (opens in a new tab)</span>}</span>
            </a>
            );
          })}
        </div>
      </div>
    </section>

    <section class="section home-virtuoso">
      <div class="shell virtuoso-grid">
        {/* Virtuoso's own reverse artwork for dark grounds, straight on the navy. Its member logo
            guidelines (June 2021) list a box around the logo as a misuse, which retired the white
            plate this mark sat on until 1 November 2026. Same lead-column placement as Luxury. */}
        <div class="virtuoso-copy">
          <Image class="virtuoso-mark" src={virtuosoMark} alt="Virtuoso member" height={110} loading="lazy" />
          <h2>{home.virtuoso.heading}</h2>
          <p>{home.virtuoso.body}</p>
          <a class="button button-white" href="/luxury/#virtuoso">{home.virtuoso.button}</a>
        </div>
        {/* Gina's two benefits, so the band says what membership does for a client rather than
            only that it exists (docs/REFERENCES.md). */}
        <VirtuosoBenefits tone="dark" />
      </div>
    </section>

    {/* The team photograph, not Gina's portrait, since 25 October 2026 (CO2): the portrait was a
        portrait-shaped file in a box that turned landscape as the screen widened, so wide screens saw
        a close-up of her face. The frame now keeps the photograph's own ratio at every width. */}
    {gina && (
      <section class="section founder-feature">
        <div class="shell about-grid">
          <figure class="founder-visual">
            <Image src={teamOffice} alt={home.founder.imageAlt}
              widths={[480, 904]} sizes="(max-width: 940px) 92vw, 540px" loading="lazy" />
            <figcaption>{home.founder.caption}</figcaption>
          </figure>
          <div class="about-copy">
            <h2>{home.founder.heading}</h2>
            <p class="about-lead">{home.founder.lead}</p>
            <p>{home.founder.body}</p>
            {/* Read as Gina's own words, so it stays empty until she supplies one (register C26). */}
            {home.founder.quote
              ? <blockquote>{home.founder.quote}</blockquote>
              : <p class="placeholder-note" data-placeholder>TODO: a line from Gina, in her own words</p>}
            <a class="text-link" href="/who-we-are/">{home.founder.link}</a>
          </div>
        </div>
      </section>
    )}

    {featured && (
      <section class="section journal-teaser" aria-labelledby="journal-heading">
        <div class="shell">
          <div class="section-intro section-intro--with-link">
            <div>
              <h2 id="journal-heading">{home.journal.heading}</h2>
              <p>{home.journal.intro}</p>
            </div>
            <a class="text-link" href="/journal/">{home.journal.allLink}</a>
          </div>
          <article class="home-story">
            <a class="home-story-image" href={`/journal/${featured.id}/`} tabindex="-1" aria-hidden="true">
              <Image src={featured.data.cover} alt=""
                widths={[480, 960, 1440]} sizes="(max-width: 900px) 92vw, 58vw" loading="lazy" />
            </a>
            <div class="home-story-copy">
              <h3><a href={`/journal/${featured.id}/`}>{featured.data.title}</a></h3>
              {/* No rubric, date or "Read the story" on the home page (CO5): a teaser sells the story,
                  and the headline and photograph are already its link. */}
              <p>{featured.data.standfirst}</p>
            </div>
          </article>
        </div>
      </section>
    )}

    <WhyBook variant="full" />
  </main>
</BaseLayout>
