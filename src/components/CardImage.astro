---
/**
 * A card photograph at a fixed ratio, or the marked placeholder when there is none.
 *
 * Three states, all visible:
 * - no `image` named: the placeholder shows `label`, as before;
 * - `image` named and present: the photograph, cropped to `ratio` at `position`;
 * - `image` named but the file is missing: a placeholder naming the missing file. An approved
 *   image that has not been downloaded yet must read as a gap on the page, not fail silently.
 */
import { Image } from 'astro:assets';
import PlaceholderImage from './PlaceholderImage.astro';
import { findImage } from '../lib/images';

interface Props {
  image?: string | null;
  alt?: string;
  label: string;
  ratio: '4/5' | '16/9' | '3/2';
  /** CSS object-position, for deliberate crops of a differently shaped original. */
  position?: string;
  widths: number[];
  sizes: string;
}

const { image, alt = '', label, ratio, position = 'center', widths, sizes } = Astro.props;
const src = findImage(image);
---

{src
  ? <Image
      class="card-image"
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading="lazy"
      style={`aspect-ratio: ${ratio}; object-position: ${position};`}
    />
  : <PlaceholderImage label={image ? `TODO: approved image not yet installed (${image})` : label} ratio={ratio} />}
