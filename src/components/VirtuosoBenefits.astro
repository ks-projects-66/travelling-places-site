---
/**
 * Gina's two Virtuoso benefits, one component for every page that shows them (home band, Luxury).
 * Until 25 October 2026 the same two paragraphs were a centred white card on home and a hairline
 * two-column grid on Luxury, and the owner found both awkward (docs/CALLOUTS-2026-10-25.md, CO4 and
 * CO11). Now they are one stacked pair everywhere: serif title, text at the lead size, space
 * between them rather than rules or a panel.
 */
import virtuoso from '../data/virtuoso.json';

interface Props {
  /** `dark` on the navy home band, `light` on page ground or mist. */
  tone?: 'light' | 'dark';
  /** Heading level for the two titles, so they sit under the section's own heading. */
  level?: 'h3' | 'h4';
}
const { tone = 'light', level: Heading = 'h3' } = Astro.props;
---

<div class:list={['virtuoso-benefits', `virtuoso-benefits--${tone}`]}>
  {virtuoso.benefits.map((benefit) => (
    <div class="virtuoso-benefit">
      <Heading>{benefit.title}</Heading>
      <p>{benefit.body}</p>
    </div>
  ))}
</div>
