---
/**
 * A visible, marked stand-in for imagery that has not been supplied or cleared.
 * Holds the correct aspect ratio so layout is honest before the real photograph lands.
 * Ratios follow the Belmond guideline in DESIGN.md: 4/5 cards, 16/9 context, 1/1 grid.
 */
interface Props {
  label: string;
  ratio?: '4/5' | '16/9' | '1/1' | '3/2';
  class?: string;
}

const { label, ratio = '4/5', class: className = '' } = Astro.props;
---

<div
  class:list={['placeholder-image', className]}
  style={`aspect-ratio: ${ratio};`}
  data-placeholder
  role="img"
  aria-label={`Placeholder: ${label}`}
>
  <span>{label}</span>
</div>
