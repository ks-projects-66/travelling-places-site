---
/**
 * The full-bleed page hero. One photograph, edge to edge, with the title over it.
 *
 * This replaces the contained two-column and text-only heroes. DESIGN.md has always
 * specified "Heroes: Full-bleed, edge to edge, no containing gutter"; the pages did not
 * do it, which was the largest single gap against the imagery reference.
 *
 * Pages with no cleared photograph use tone="navy": the same full-bleed opening on the brand
 * navy instead of an image. It reads as a finished design rather than a gap, and swapping in a
 * licensed photograph later is a one-line prop change. See src/assets/images/MANIFEST.md for
 * which pages are waiting on photography.
 *
 * Pass `slides` instead of `image` and the photograph becomes a sequence: the title, lede and
 * actions stay fixed while the photographs cross-fade beneath them. The home page uses this since
 * 25 October 2026 (docs/WORK-PLAN.md, change 3). Behaviour lives in site.js under [data-carousel].
 * Since 26 October 2026 previous, progress and next sit together in the bottom-right corner, level
 * with the actions; at either edge of the photograph the arrows met the eye before the title, and
 * below 1366px they jumped to the top corners (design review, home finding 1).
 *
 * Openings vary by purpose rather than repeating one template (design review, site-wide P1):
 * - `size="full"`: the photograph fills most of the first screen. Home and Luxury.
 * - `size="short"`: a shorter band, so the opening statement below it arrives in the first screen.
 *   Tailor-made.
 * - `layout="split"`: the title on the page ground beside the photograph, for a photograph of
 *   people, which a full-bleed crop and a text overlay both work against. About.
 * Contact has no hero at all: the enquiry form is its opening.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface HeroSlide {
  src: ImageMetadata;
  alt: string;
  position?: string;
  /** Crop on phones, where the frame is portrait and `position` can miss the subject. */
  mobilePosition?: string;
}

interface Props {
  /** Photographs for a rotating hero. Mutually exclusive with `image`. */
  slides?: HeroSlide[];
  /** Cap the generated srcset when the source is smaller than the hero. See `widths` below. */
  maxWidth?: number;
  lead: string;
  accent: string;
  lede?: string;
  image?: ImageMetadata;
  alt?: string;
  tone?: 'photo' | 'navy';
  position?: string;
  mobilePosition?: string;
  size?: 'full' | 'short';
  layout?: 'overlay' | 'split';
  class?: string;
}

const {
  slides,
  maxWidth,
  lead,
  accent,
  lede,
  image,
  alt = '',
  tone = image || slides?.length ? 'photo' : 'navy',
  position = 'center',
  mobilePosition,
  size = 'full',
  layout = 'overlay',
  class: className = '',
} = Astro.props;

if (tone === 'photo' && !image && !slides?.length) {
  throw new Error('PageHero tone="photo" needs an image or slides.');
}
if (image && slides?.length) {
  throw new Error('PageHero takes an image or slides, not both.');
}
const isCarousel = Boolean(slides && slides.length > 1);
const isSplit = layout === 'split';
// Crops travel as custom properties rather than an inline object-position, so a media query can
// switch to the phone crop (an inline declaration would outrank it).
const crop = (desktop: string, phone?: string) =>
  `--crop: ${desktop};${phone ? ` --crop-phone: ${phone};` : ''}`;

/* Astro will not upscale past the source, so a photograph narrower than the hero silently loses
   its larger candidates. `maxWidth` keeps every step below the source and then adds the source
   width itself, so the largest candidate is the sharpest the file can actually give. */
const HERO_WIDTHS = [768, 1280, 1920, 2560];
const heroWidths = maxWidth
  ? [...HERO_WIDTHS.filter((w) => w < maxWidth), maxWidth]
  : HERO_WIDTHS;
---

<section
  class:list={[
    'page-hero',
    isSplit ? 'page-hero--split' : `page-hero--${tone}`,
    size === 'short' && 'page-hero--short',
    isCarousel && 'page-hero--carousel',
    className,
  ]}
  data-carousel={isCarousel ? '' : undefined}
  aria-roledescription={isCarousel ? 'carousel' : undefined}
  aria-label={isCarousel ? 'Featured journeys' : undefined}
>
  {slides && (
    <div class="page-hero-media">
      {slides.map((slide, i) => (
        <div
          class:list={['page-hero-slide', i === 0 && 'is-active']}
          data-slide
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${slides.length}`}
          aria-hidden={i === 0 ? undefined : 'true'}
        >
          <Image
            src={slide.src}
            alt={slide.alt}
            widths={heroWidths}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'low'}
            style={crop(slide.position ?? 'center', slide.mobilePosition)}
          />
        </div>
      ))}
    </div>
  )}

  {image && (
    <div class="page-hero-media">
      <Image
        src={image}
        alt={alt}
        widths={heroWidths}
        sizes={isSplit ? '(max-width: 940px) 100vw, 58vw' : '100vw'}
        loading="eager"
        style={crop(position, mobilePosition)}
      />
    </div>
  )}

  {/* The split layout sets its own column and edge, so its text block is not a .shell. */}
  <div class:list={['page-hero-inner', !isSplit && 'shell']}>
    <slot name="above" />
    <h1 data-carousel-hold={isCarousel ? '' : undefined}><span class="hero-line">{lead}</span> <span class="hero-accent">{accent}</span></h1>
    {lede && <p class="page-hero-lede" data-carousel-hold={isCarousel ? '' : undefined}>{lede}</p>}
    <slot />

    {isCarousel && (
      <div class="page-hero-controls" data-carousel-hold>
        <button class="carousel-icon-button page-hero-arrow" type="button"
          aria-label="Previous photograph" data-carousel-previous>
          <svg aria-hidden="true" focusable="false"><use href="/brand-kit/assets/icons/ui-icons.svg#icon-chevron-left"></use></svg>
        </button>
        {/* Which photograph is showing. Decorative: each slide already announces "n of 3" to
            assistive technology. */}
        <span class="page-hero-progress" aria-hidden="true">
          {slides!.map((_, i) => <span class:list={[i === 0 && 'is-active']} data-progress></span>)}
        </span>
        <button class="carousel-icon-button page-hero-arrow" type="button"
          aria-label="Next photograph" data-carousel-next>
          <svg aria-hidden="true" focusable="false"><use href="/brand-kit/assets/icons/ui-icons.svg#icon-chevron-right"></use></svg>
        </button>
      </div>
    )}
  </div>
</section>
