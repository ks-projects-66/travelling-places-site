---
import { Image } from 'astro:assets';
import nav from '../data/navigation.json';
import site from '../data/site.json';
import memberships from '../data/memberships.json';
import partners from '../data/partners.json';
import PlaceholderImage from './PlaceholderImage.astro';
import NewsletterForm from './NewsletterForm.astro';

const marks = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/memberships/*.{jpg,png,webp,svg}',
  { eager: true },
);
const markFor = (file: string) => marks[`../assets/images/memberships/${file}`]?.default;

const year = new Date().getFullYear();
const unresolvedIdentifiers = Object.values(site.identifiers).filter((i) => i.status === 'placeholder');
---

<footer class="site-footer">
  <div class="shell footer-memberships">
    <h2 class="footer-heading">Accredited and connected</h2>
    <ul class="logo-wall" aria-label="Industry memberships and accreditations">
      {memberships.map((m) => {
        const img = markFor(m.image);
        return (
          <li>
            {m.url
              ? <a href={m.url} target="_blank" rel="noreferrer" aria-label={`${m.name} (opens in a new tab)`}>
                  <Image src={img} alt={m.alt} height={56} densities={[1, 2]} loading="lazy" />
               </a>
              : <Image src={img} alt={m.alt} height={56} densities={[1, 2]} loading="lazy" />}
          </li>
        );
      })}
    </ul>

    <h2 class="footer-heading">Travel partners</h2>
    <ul class="logo-wall logo-wall-partners" aria-label="Travel partners">
      {partners.map((p) => (
        <li><PlaceholderImage label={p.name} ratio="3/2" class="logo-placeholder" /></li>
      ))}
    </ul>
  </div>

  <div class="shell footer-newsletter">
    <NewsletterForm />
  </div>

  <div class="shell footer-main">
    <a class="footer-brand" href="/" aria-label={`${site.name} home`}>
      <img src="/brand-kit-v2/assets/logos/lockup-dark.svg" width="958" height="360" alt={site.name} loading="lazy" />
   </a>
    <div class="footer-note">
      <p>Personal travel planning from {site.address.locality}.</p>
      <address>
        <a href={site.phoneLink}>{site.phone}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </address>
      <a class="text-link secondary-link" href={site.virtuoso.profileUrl} target="_blank" rel="noreferrer">
        Our Virtuoso profile
     </a>
    </div>
    <div class="footer-nav-wrap">
      <nav class="footer-links" aria-label="Footer navigation">
        {nav.footer.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <nav class="social-links" aria-label="Social media">
        <a href={site.socials.instagram.url} target="_blank" rel="noreferrer">Instagram</a>
        <a href={site.socials.facebook.url} target="_blank" rel="noreferrer">Facebook</a>
      </nav>
    </div>
  </div>

  <div class="shell footer-legal">
    <span>© {year} {site.name}</span>
    {unresolvedIdentifiers.length > 0
      ? <span class="placeholder-note" data-placeholder>TODO: ABN, ATIA and CLIA numbers</span>
      : <span>ABN {site.identifiers.abn.value} · ATIA {site.identifiers.atiaAccreditation.value} · CLIA {site.identifiers.cliaMembership.value}</span>}
  </div>
</footer>
