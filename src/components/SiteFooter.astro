---
import { Image } from 'astro:assets';
import nav from '../data/navigation.json';
import site from '../data/site.json';
import memberships from '../data/memberships.json';
import topBar from '../data/top-bar.json';

const marks = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/memberships/*.{jpg,png,webp,svg}',
  { eager: true },
);
const markFor = (file: string) => marks[`../assets/images/memberships/${file}`]?.default;

const year = new Date().getFullYear();
const unresolvedIdentifiers = Object.values(site.identifiers).filter((i) => i.status === 'placeholder');
const socialsUnconfirmed =
  site.socials.instagram.status !== 'confirmed' || site.socials.facebook.status !== 'confirmed';
const socials = [
  { label: 'Instagram', icon: 'icon-instagram', url: site.socials.instagram.url },
  { label: 'Facebook', icon: 'icon-facebook', url: site.socials.facebook.url },
];
---

<footer class="site-footer">
  {/* Accreditation and memberships: one quiet row of marks on white, above the navy footer
      (client brief, change 7; docs/WORK-PLAN.md section 3). Ordered by what each means to a
      client: ATIA's accreditation first, then CLIA, Virtuoso and Alatus. No visible heading, as
      on the peer sites; the marks carry their own names. On white the supplied artwork needs no
      plate. The partner placeholders were removed at the client's request. */}
  <div class="footer-trust">
    <div class="shell">
      <h2 class="visually-hidden">Accreditation and memberships</h2>
      <ul class="trust-marks">
        {memberships.map((m) => {
          const img = markFor(m.image);
          // stripHeight evens out optical size: the Virtuoso and Alatus files carry wide white
          // margins and light wordmarks, so at one shared height they read half the size of ATIA
          // and CLIA. The artwork itself is untouched.
          const style = `--mark-h: ${m.stripHeight ?? 56}px`;
          return (
            <li style={style}>
              {m.url
                ? <a href={m.url} target="_blank" rel="noreferrer" aria-label={`${m.alt} (opens in a new tab)`}>
                    <Image src={img} alt="" height={m.stripHeight ?? 56} densities={[1, 2]} loading="lazy" />
                  </a>
                : <Image src={img} alt={m.alt} height={m.stripHeight ?? 56} densities={[1, 2]} loading="lazy" />}
            </li>
          );
        })}
      </ul>
    </div>
  </div>

  <div class="shell footer-newsletter">
    <div class="newsletter">
      <div class="newsletter-copy">
        <h2>{topBar.newsletter.heading}</h2>
        <p>{topBar.newsletter.footerLine}</p>
      </div>
      <a class="button button-white" href={`mailto:${site.email}?subject=Newsletter%20sign-up`} data-open-newsletter>
        {topBar.newsletter.footerButton}
      </a>
    </div>
  </div>

  <div class="shell footer-columns">
    <div class="footer-column">
      <a class="footer-brand" href="/" aria-label={`${site.name} home`}>
        <img src="/brand-kit/assets/logos/lockup-dark.svg" width="958" height="360" alt={site.name} loading="lazy" />
      </a>
      <p>Personal travel planning from {site.address.locality}.</p>
    </div>
    <div class="footer-column">
      <h2 class="footer-heading">Contact</h2>
      <address class="footer-list">
        <a href={site.phoneLink}>{site.phone}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </address>
    </div>
    <nav class="footer-column" aria-label="Footer navigation">
      <h2 class="footer-heading">Explore</h2>
      <div class="footer-list">
        {nav.footer.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
    </nav>
    <nav class="footer-column" aria-label="Social media">
      <h2 class="footer-heading">Follow</h2>
      <div class="footer-list">
        {socials.map((s) => (
          <a class="footer-social" href={s.url} target="_blank" rel="noreferrer">
            <span class="footer-social-icon" aria-hidden="true">
              <svg focusable="false"><use href={`/brand-kit/assets/icons/ui-icons.svg#${s.icon}`}></use></svg>
            </span>
            {s.label}
          </a>
        ))}
        {socialsUnconfirmed && (
          <span class="placeholder-note" data-placeholder>TODO: social links not yet confirmed</span>
        )}
      </div>
    </nav>
  </div>

  <div class="shell footer-legal">
    <span>© {year} {site.name}</span>
    {unresolvedIdentifiers.length > 0
      ? <span class="placeholder-note" data-placeholder>TODO: ABN, ATIA and CLIA numbers</span>
      : <span>ABN {site.identifiers.abn.value} · ATIA {site.identifiers.atiaAccreditation.value} · CLIA {site.identifiers.cliaMembership.value}</span>}
    <a href="/privacy/">Privacy</a>
  </div>
</footer>
