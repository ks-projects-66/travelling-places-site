---
import EnquiryForm from './EnquiryForm.astro';
---

<dialog class="enquiry-dialog" data-enquiry-dialog aria-labelledby="enquiry-title">
  <div class="dialog-topline">
    <span>Begin a conversation</span>
    <button class="dialog-close" type="button" aria-label="Close enquiry form" data-close-enquiry>×</button>
  </div>
  <div class="dialog-content">
    <h2 id="enquiry-title">Where would you like to go?</h2>
    <p>Share the first few details and we'll be in touch.</p>
    <EnquiryForm context="dialog" />
  </div>
</dialog>
