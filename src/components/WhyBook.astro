---
/**
 * "Why book with Travelling Places?", Gina's closing band. It ends every page, so the last
 * thing a visitor reads is her reasons to book and a way to call.
 *
 * Rebalanced 25 October 2026 at the client's request (docs/WORK-PLAN.md, change 6), then again the
 * same day (docs/CALLOUTS-2026-10-25.md, CO6): the invitation and the way to call on the left, her
 * services and her two credentials on the right, on the page rather than on a white panel.
 */
import copy from '../data/why-book.json';
import site from '../data/site.json';

interface Props {
  /**
   * `full` is Gina's whole band, on the home page. `short` ends every other page with her
   * contact line and the one action. Since 25 October 2026: the full band closed six of nine
   * pages, sat directly under "Why book a tailor-made holiday?" on Expertise and repeated About's
   * financial-security claims, so a visitor met the same checklist at the end of every page
   * (re-critique, P2; docs/POLISH-PLAN.md D1).
   */
  variant?: 'full' | 'short';
}
const { variant = 'short' } = Astro.props;
// The spaces around the phone link are explicit {' '}: Astro's HTML compression drops a literal
// space that sits between an expression and a tag, which glued the number to "on" and "to" on
// every page (owner callout, 25 October 2026). qa/specs/functional/spacing.spec.js guards it.
---

{variant === 'short' ? (
<section class="section closing-cta why-book why-book--short" aria-label="Start planning">
  <div class="shell why-book-short">
    <p class="why-book-contact">
      {copy.contactLead}{' '}<a href={site.phoneLink}>{site.phone}</a>{' '}{copy.contactMiddle}{' '}
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
    <a class="button button-blue" href="/contact/#enquiry">{copy.cta}</a>
  </div>
</section>
) : (

<section class="section closing-cta why-book" aria-labelledby="why-book-heading">
  <div class="shell why-book-grid">
    <div class="why-book-intro">
      <h2 id="why-book-heading">{copy.heading}</h2>
      <p>{copy.intro}</p>
      <p class="why-book-contact">
        {copy.contactLead}{' '}<a href={site.phoneLink}>{site.phone}</a>{' '}{copy.contactMiddle}{' '}
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <a class="button button-blue" href="/contact/#enquiry">{copy.cta}</a>
    </div>
    {/* Services and credentials, apart (CO6). On a white panel the two lists read as leftovers;
        on the page, the services take the site's inclusions set and the two credentials the proof
        lines used for financial security on About. */}
    <div class="why-book-reasons">
      <h3>{copy.services.title}</h3>
      <ul class="inclusions">
        {copy.services.points.map((point) => <li>{point}</li>)}
      </ul>
      <ul class="proof-list why-book-proof">
        {copy.proof.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>
)}
