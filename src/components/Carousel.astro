---
import { Image } from 'astro:assets';

export interface Slide {
  src: ImageMetadata;
  alt: string;
  place: string;
  headline: string;
}
interface Props { slides: Slide[] }
const { slides } = Astro.props;
---

<section class="destination-carousel" aria-labelledby="carousel-title" data-carousel>
  <div class="carousel-heading shell">
    <div>
      <h2 id="carousel-title">Where will curiosity take you?</h2>
    </div>
    <p>Pause on a place, or let the journey unfold.</p>
  </div>
  <div class="carousel-viewport" aria-live="off">
    {slides.map((slide, i) => (
      <article class:list={['carousel-slide', i === 0 && 'is-active']} data-slide aria-hidden={i === 0 ? undefined : 'true'}>
        <Image src={slide.src} alt={slide.alt} widths={[768, 1280, 1920, 2560]}
          sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} />
        <div class="carousel-caption">
          <h3>{slide.headline}</h3>
        </div>
      </article>
    ))}
  </div>
  <div class="carousel-controls shell">
    <div class="carousel-dots" role="group" aria-label="Choose a destination">
      {slides.map((slide, i) => (
        <button type="button" class:list={[i === 0 && 'is-active']} data-carousel-dot={i}
          aria-label={`Show ${slide.place}`} aria-pressed={i === 0 ? 'true' : 'false'}></button>
      ))}
    </div>
    <div class="carousel-buttons">
      <button class="carousel-icon-button" type="button" data-carousel-play aria-label="Pause carousel" aria-pressed="false">
        <svg aria-hidden="true" focusable="false"><use href="/brand-kit-v2/assets/icons/ui-icons.svg#icon-pause" data-play-icon></use></svg>
      </button>
      <button class="carousel-icon-button" type="button" data-carousel-prev aria-label="Previous destination">
        <svg aria-hidden="true" focusable="false"><use href="/brand-kit-v2/assets/icons/ui-icons.svg#icon-chevron-left"></use></svg>
      </button>
      <button class="carousel-icon-button" type="button" data-carousel-next aria-label="Next destination">
        <svg aria-hidden="true" focusable="false"><use href="/brand-kit-v2/assets/icons/ui-icons.svg#icon-chevron-right"></use></svg>
      </button>
    </div>
  </div>
</section>
