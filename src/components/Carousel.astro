---
import { Image } from 'astro:assets';

export interface Slide {
  src: ImageMetadata;
  alt: string;
  place: string;
  headline: string;
}
interface Props { slides: Slide[] }
const { slides } = Astro.props;
---

<section class="destination-carousel" aria-labelledby="carousel-title" data-carousel>
  <div class="carousel-heading shell">
    <h2 id="carousel-title">Where will curiosity take you?</h2>
  </div>
  <div class="carousel-viewport" aria-live="off">
    {slides.map((slide, i) => (
      <article class:list={['carousel-slide', i === 0 && 'is-active']} data-slide aria-hidden={i === 0 ? undefined : 'true'}>
        <Image src={slide.src} alt={slide.alt} widths={[768, 1280, 1920, 2560]}
          sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} />
        <div class="carousel-caption">
          <h3>{slide.headline}</h3>
        </div>
      </article>
    ))}
  </div>
</section>
