{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": {
    "name": "Travelling Places",
    "version": "3.0.0",
    "reference": "Belmond for restraint, image priority, and typographic balance. Never copy layouts or proprietary assets."
  },
  "color": {
    "white": {
      "value": "#FFFFFF",
      "role": "Panels and text on brand colours"
    },
    "ground": {
      "value": "#FAF8F5",
      "role": "Primary page surface. Warm off-white, not pure white"
    },
    "mist": {
      "value": "#F2EFEA",
      "role": "Quiet secondary surface. Warm grey"
    },
    "navy": {
      "value": "#25335F",
      "role": "Dark sections, footer, and primary headings"
    },
    "blue": {
      "value": "#3E55A0",
      "role": "Primary interaction colour"
    },
    "red": {
      "value": "#D7333F",
      "role": "Small accent and focus colour only. Not for text below 24px on a light surface"
    },
    "redText": {
      "value": "#C92B37",
      "role": "Red for small text. The brand red is 4.13:1 on mist and fails AA; this clears 4.71:1 on every light surface"
    },
    "ink": {
      "value": "#272B38",
      "role": "Body text"
    },
    "muted": {
      "value": "#5C6274",
      "role": "Secondary text"
    },
    "line": {
      "value": "#DED8D0",
      "role": "Borders and rules"
    }
  },
  "font": {
    "display": {
      "family": "Libre Baskerville",
      "weight": 400,
      "style": "normal",
      "fallback": "Baskerville, Georgia, serif"
    },
    "body": {
      "family": "IBM Plex Sans",
      "weights": [
        400,
        500,
        600
      ],
      "style": "normal",
      "fallback": "Segoe UI, Arial, sans-serif"
    }
  },
  "type": {
    "display": {
      "min": "34px",
      "max": "56px",
      "lineHeight": 1.08,
      "maxWidth": "24ch",
      "maximumLines": 2,
      "maximumLinesArticleTitle": 3
    },
    "pageTitle": {
      "min": "36px",
      "max": "48px",
      "lineHeight": 1.12,
      "maxWidth": "22ch"
    },
    "sectionTitle": {
      "min": "30px",
      "max": "40px",
      "lineHeight": 1.16,
      "maxWidth": "24ch"
    },
    "subsectionTitle": {
      "min": "22px",
      "max": "28px",
      "lineHeight": 1.25,
      "maxWidth": "30ch"
    },
    "menuTitle": {
      "min": "26px",
      "max": "30px",
      "lineHeight": 1.2
    },
    "lead": {
      "min": "18px",
      "max": "19px",
      "lineHeight": 1.55,
      "maxWidth": "58ch"
    },
    "label": {
      "size": "16px",
      "lineHeight": 1.4,
      "weight": 500,
      "role": "Row and card labels. Body sans, never display serif"
    },
    "body": {
      "size": "16px",
      "lineHeight": 1.65,
      "maxWidth": "68ch"
    },
    "navigation": {
      "size": "14px",
      "lineHeight": 1.4,
      "weight": 500
    },
    "button": {
      "size": "16px",
      "lineHeight": 1.4,
      "weight": 600
    },
    "finePrint": {
      "size": "13px",
      "lineHeight": 1.5
    },
    "metaLabel": {
      "size": "12.5px",
      "lineHeight": 1.4,
      "weight": 600,
      "letterSpacing": "0.06em",
      "textTransform": "uppercase",
      "role": "The one approved uppercase treatment. Story meta, role labels, roster roles. Never a heading element."
    }
  },
  "space": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "2xl": "32px",
    "3xl": "48px",
    "4xl": "64px",
    "5xl": "80px",
    "6xl": "96px",
    "sectionMax": "120px"
  },
  "layout": {
    "contentMax": "1200px",
    "readingMax": "720px",
    "gutterMin": "20px",
    "gutterMax": "48px",
    "gridColumns": 12
  },
  "shape": {
    "buttonRadius": "999px",
    "fieldRadius": "2px",
    "imageRadius": "0px"
  },
  "motion": {
    "fast": "160ms",
    "standard": "220ms",
    "carouselIdle": "6000ms (kit component); 3000ms (website, no visible control)",
    "easing": "cubic-bezier(0.22, 1, 0.36, 1)"
  },
  "interaction": {
    "minimumTarget": "24px",
    "preferredButtonHeight": "50px",
    "buttonInlinePadding": "28px",
    "focusWidth": "3px",
    "focusOffset": "3px",
    "minimumTargetStandard": "WCAG 2.5.8 AA, with the inline and spacing exceptions",
    "preferredTarget": "44px"
  },
  "logo": {
    "minimumLockupWidth": "172px",
    "minimumWordmarkWidth": "120px",
    "minimumMarkHeight": "48px"
  }
}
