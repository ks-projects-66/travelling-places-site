{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": {
    "name": "Travelling Places",
    "version": "2.1.0",
    "reference": "Belmond for restraint, image priority, and typographic balance. Never copy layouts or proprietary assets."
  },
  "color": {
    "white": { "value": "#FFFFFF", "role": "Primary page surface and text on brand colours" },
    "mist": { "value": "#F1F2F6", "role": "Quiet secondary surface" },
    "navy": { "value": "#25335F", "role": "Dark sections, footer, and primary headings" },
    "blue": { "value": "#3E55A0", "role": "Primary interaction colour" },
    "red": { "value": "#D7333F", "role": "Small accent and focus colour only" },
    "ink": { "value": "#272B38", "role": "Body text" },
    "muted": { "value": "#5C6274", "role": "Secondary text" },
    "line": { "value": "#D8DAE4", "role": "Borders and rules" }
  },
  "font": {
    "display": {
      "family": "Libre Baskerville",
      "weight": 400,
      "style": "normal",
      "fallback": "Baskerville, Georgia, serif"
    },
    "body": {
      "family": "IBM Plex Sans",
      "weights": [400, 500, 600],
      "style": "normal",
      "fallback": "Segoe UI, Arial, sans-serif"
    }
  },
  "type": {
    "display": { "min": "34px", "max": "56px", "lineHeight": 1.08, "maxWidth": "24ch", "maximumLines": 2 },
    "pageTitle": { "min": "36px", "max": "48px", "lineHeight": 1.12, "maxWidth": "22ch" },
    "sectionTitle": { "min": "30px", "max": "40px", "lineHeight": 1.16, "maxWidth": "24ch" },
    "subsectionTitle": { "min": "22px", "max": "28px", "lineHeight": 1.25, "maxWidth": "30ch" },
    "menuTitle": { "min": "26px", "max": "30px", "lineHeight": 1.2 },
    "lead": { "min": "18px", "max": "19px", "lineHeight": 1.55, "maxWidth": "58ch" },
    "body": { "size": "16px", "lineHeight": 1.65, "maxWidth": "68ch" },
    "navigation": { "size": "14px", "lineHeight": 1.4, "weight": 500 },
    "button": { "size": "14px", "lineHeight": 1.4, "weight": 500 },
    "finePrint": { "size": "13px", "lineHeight": 1.5 }
  },
  "space": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "2xl": "32px",
    "3xl": "48px",
    "4xl": "64px",
    "5xl": "80px",
    "6xl": "96px",
    "sectionMax": "120px"
  },
  "layout": {
    "contentMax": "1200px",
    "readingMax": "720px",
    "gutterMin": "20px",
    "gutterMax": "48px",
    "gridColumns": 12
  },
  "shape": {
    "buttonRadius": "999px",
    "fieldRadius": "2px",
    "imageRadius": "0px"
  },
  "motion": {
    "fast": "160ms",
    "standard": "220ms",
    "carouselIdle": "6000ms",
    "easing": "cubic-bezier(0.22, 1, 0.36, 1)"
  },
  "interaction": {
    "minimumTarget": "44px",
    "preferredButtonHeight": "50px",
    "buttonInlinePadding": "28px",
    "focusWidth": "3px",
    "focusOffset": "3px"
  }
}
